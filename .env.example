# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional server-side salt for SHA-256 visitor IP hashing (Cloudflare Pages Secrets / .env).
VISITOR_IP_SALT=""

# Optional server-side email notification for new visitor registrations (via Resend API).
# Configure these in Cloudflare Pages Environment Variables / Secrets (never prefix with VITE_).
RESEND_API_KEY=""
VISITOR_NOTIFY_TO=""
VISITOR_NOTIFY_FROM=""

# Optional Firebase Auth client overrides for Cloudflare Pages / custom environments.
# Firebase Auth (Google Sign-In) is still used for admin login; if omitted, falls back to firebase-applet-config.json.
# VITE_FIREBASE_API_KEY=""
# VITE_FIREBASE_AUTH_DOMAIN=""
# VITE_FIREBASE_PROJECT_ID=""
# VITE_FIREBASE_STORAGE_BUCKET=""
# VITE_FIREBASE_MESSAGING_SENDER_ID=""
# VITE_FIREBASE_APP_ID=""
# VITE_FIREBASE_FIRESTORE_DATABASE_ID=""
